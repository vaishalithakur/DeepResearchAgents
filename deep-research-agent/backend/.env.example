# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Required: get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Only needed if your key is "identity-linked" rather than workspace-scoped
# -- you'll know because requests fail with a 400 mentioning
# anthropic-workspace-id. Find your workspace ID in the Console under
# Settings -> Workspaces. Leave blank for a normal workspace API key.
ANTHROPIC_WORKSPACE_ID=

# Model used for the analysis graph
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048

# App
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=30

# Analysis graph behaviour
MAX_RESEARCH_REVISIONS=2
MAX_COMPETITORS=4
WEB_SEARCH_MAX_USES=3

# LangSmith observability (optional -- tracing stays off unless both of
# these are set; get a key at https://smith.langchain.com/settings)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fieldnote-competitive-intelligence
